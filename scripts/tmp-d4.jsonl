r[0] !== \\\"地理坐标\\\") {\\n      s.addShape(pres.shapes.LINE, { x: lx + 0.25, y: yy + 0.54, w: lw - 0.5, h: 0, line: { color: \\\"EDF1F6\\\", width: 1 } });\\n    }\\n    yy += 0.57;\\n  });\\n  s.addText(\\\"以上数值为园区主体接口返回原始值，未标注单位。\\\", {\\n    x: lx + 0.25, y: ly + lh - 0.62, w: lw - 0.5, h: 0.34, fontFace: FF, fontSize: 9.5, color: MUTED, margin: 0\\n  });\\n  // right: key metrics panel (2x2 tiles)\\n  const rx = lx + lw + 0.3, rw = W - MX - rx;\\n  card(s, rx, ly, rw, lh);\\n  cardTitle(s, rx, ly, rw, \\\"面积关键指标\\\", ACCENT);\\n  const tiles = [\\n    [\\\"1.78\\\", \\\"规划面积\\\", \\\"化工园区整体规划\\\", STEEL],\\n    [\\\"1.78\\\", \\\"建成面积\\\", \\\"规划区已完成建设\\\", STEEL],\\n    [\\\"8.9\\\", \\\"危化品面积\\\", \\\"涉及危险化学品区域\\\", ACCENT],\\n    [\\\"5\\\", \\\"化工企业占比\\\", \\\"占园区全部企业比重\\\", AMBERD]\\n  ];\\n  const innerX = rx + 0.28, innerW = rw - 0.56;\\n  const gw = (innerW - 0.2) / 2, gh = 2.05;\\n  const gy1 = ly + 0.78, gy2 = gy1 + gh + 0.2;\\n  const tileXY = [[innerX, gy1], [innerX + gw + 0.2, gy1], [innerX, gy2], [innerX + gw + 0.2, gy2]];\\n  tiles.forEach(function (t, idx) {\\n    const tx = tileXY[idx][0], ty = tileXY[idx][1];\\n    s.addShape(pres.shapes.ROUNDED_RECTANGLE, {\\n      x: tx, y: ty, w: gw, h: gh, fill: { color: BG }, line: { color: TRACK, width: 1 }, rectRadius: 0.09\\n    });\\n    s.addShape(pres.shapes.RECTANGLE, { x: tx + 0.22, y: ty + 0.28, w: 0.5, h: 0.06, fill: { color: t[3] } });\\n    s.addText(String(t[0]), { x: tx, y: ty + 0.52, w: gw, h: 0.9, fontFace: FF, fontSize: 42, bold: true, color: t[3], align: \\\"center\\\", margin: 0 });\\n    s.addText(t[1], { x: tx, y: ty + 1.5, w: gw, h: 0.34, fontFace: FF, fontSize: 12.5, bold: true, color: INK, align: \\\"center\\\", margin: 0 });\\n    s.addText(t[2], { x: tx + 0.12, y: ty + 1.8, w: gw - 0.24, h: 0.28, fontFace: FF, fontSize: 8.5, color: MUTED, align: \\\"center\\\", margin: 0 });\\n  });\\n  footer(s, 2, TOTAL);\\n}\", \"old_string\": \"// ---------- Slide 2 : 园区主体信息 ----------\\n{\\n