 STEEL);\\n  safeCard(rx + gw + 0.25, yTop, \\\"安全承诺公告上报\\\", \\\"23\\\", \\\"（份）\\\", ACCENT);\\n  safeCard(rx, yTop + gh + 0.25, \\\"第三方单位\\\", \\\"8\\\", \\\"（家）\\\", STEEL);\\n  safeCard(rx + gw + 0.25, yTop + gh + 0.25, \\\"安全基础统计\\\", \\\"危险源 4 · 隐患 4 · 工艺 4\\\", \\\"（企业数）\\\", AMBERD);\\n  // bottom full-width card\\n  const yb2 = yTop + 2 * gh + 0.5, hb2 = H - 0.45 - yb2;\\n  card(s, rx, yb2, rw, hb2);\\n  cardTitle(s, rx, yb2, rw, \\\"安全生产提示\\\", AMBERD);\\n  s.addText(\\\"重大危险源、重大隐患、重点监管工艺相关企业均为 4 家，与「两重点一重大」统计一致；禁限控目录合计 159 项（禁止 79 + 限制 80）。\\\", {\\n    x: rx + 0.25, y: yb2 + 0.6, w: rw - 0.5, h: hb2 - 0.75, fontFace: FF, fontSize: 11.5, color: INK, margin: 0, valign: \\\"middle\\\"\\n  });\\n  footer(s, 5, TOTAL);\\n}\\n\\n// ---------- Slide 6 : 生产状态与园区经济 ----------\\n{\\n  const s = pres.addSlide();\\n  bg(s, BG);\\n  header(s, \\\"OPERATION · 生产与经济\\\", \\\"企业生产状态与园区经济\\\");\\n  const yTop = 1.6;\\n  // KPI row\\n  const chips = [\\n    [\\\"6\\\", \\\"正常生产企业（家）\\\", GREEN],\\n    [\\\"33\\\", \\\"2026 年总产值\\\", STEEL],\\n    [\\\"111\\\", \\\"2026 主营业务收入\\\", STEEL],\\n    [\\\"200\\\", \\\"低碳产业链产值（占比100%）\\\", ACCENT]\\n  ];\\n  const cwi = (12.23 - 3 * 0.16) / 4;\\n  let cxp = MX;\\n  chips.forEach(function (c) {\\n    kpi(s, cxp, yTop, cwi, 1.3, c[0], c[1], c[2]);\\n    cxp += cwi + 0.16;\\n  });\\n  // left: production status bars\\n  const yL = yTop + 1.62, hL = H - 0.45 - yL;\\n  const lx = MX, lw = 5.7;\\n  card(s, lx, yL, lw, hL);\\n  cardTitle(s, lx, yL, lw, \\\"生产状态分布（家）\\\", STEEL);\\n  hbarRows(s, lx, yL + 0.8, lw, 2.6, [\\n    { label: \\\"正常生产\\\", value: 6, max: 6, color: GREEN },\\n    { label: \\\"未投产\\\", value: 0, max: 6 },\\n    { label: \\\"试生产\\\", value: 0, max: 6 },\\n    { label: \\\"长期停产\\\", value: 0, max: 6 }\\n  ], 0.28);\\n  s.addText(\\\"注：16 家入驻企业中仅 6 家填报了生产状态，其余企业状态字段为空（系统原始情况）\\\", {\\n    x: lx + 0.25, y: yL + hL - 0.62, w: lw - 0.5, h: 0.5, fontFace: FF, fontSize: 9.5, color: MUTED, margin: 0, valign: \\\"top\\\"\\n  });\\n  // right: trend chart\\n  const rx = lx + lw + 0.3, rw = W - MX - rx;\\n  card(s, rx, yL, rw, hL);\\n  cardTitle(s, rx, yL, rw, \\\"历年总产值趋势（2023–2026）\\\", STEEL);\\n  s.addChart(pres.charts.BAR, [{\\n    name: \\\"总产值\\\", labels: [\\\"2023\\\", \\\"2024\\\", \\\"2025\\\", \\\"2026\\\"], values: [213, 3434, 222, 33]\\n  }], {\\n    x: rx + 0.2, y: yL + 0.5, w: rw - 0.4, h: hL - 1.15, barDir: \\\"col\\\",\\n    chartColors: [STEEL], chartArea: { fill: { color: CARD } },\\n    catAxisLabelColor: INK, catAxisLabelFontSize: 11, valAxisLabelColor: MUTED, valAxisLabelFontSize: 9,\\n    valGridLine: { color: \\\"E2E8F0\\\", size: 0.5 }, catGridLine: { style: \\\"none\\\" },\\n    showValue: true, dataLabelColor: INK, dataLabelFontSize: 10, dataLabelPosition: \\\"outEnd\\\",\\n    showLegend: false\\n  });\\n  s.addText(\\\"2026 税收 22；历年数据均为系统录入口径，未标注单位。\\\", {\\n    x: rx + 0.25, y: yL + hL - 0.55, w: rw - 0.5, h: 0.4, fontFace: FF, fontSize: 9.5, color: MUTED, margin: 0\\n  });\\n  footer(s, 6, TOTAL);\\n}\\n\\n// ---------- Slide 7 : 人才学历与创新 ----------\\n{\\n  const s = pres.addSlide();\\n  bg(s, BG);\\n  header(s, \\\"TALENT & INNOVATION · 人才创新\\\", \\\"园区人员学历与创新\\\");\\n  const yTop = 1.6;\\n  const lx = MX, lw = 6.6, hL = 5.45;\\n  card(s, lx, yTop, lw, hL);\\n  cardTitle(s, lx, yTop, lw, \\\"人员学历分布（园区人员统计 137 人）\\\", STEEL);\\n  s.addText(\\\"137\\\", { x: lx + lw - 2.4, y: yTop + 0.1, w: 2.2, h: 0.55, fontFace: FF, fontSize: 26, bold: true, color: STEEL, align: \\\"right\\\", margin: 0 });\\n  s.addText(\\\"合计（人）\\\", { x: lx + lw - 2.4, y: yTop + 0.6, w: 2.2, h: 0.3, fontFace: FF, fontSize: 9, color: MUTED, align: \\\"right\\\", margin: 0 });\\n  hbarRows(s, lx, yTop + 1.05, lw, 2.2, [\\n    { label: \\\"本科\\\", value: 120, max: 120, color: STEEL },\\n    { label: \\\"专科\\\", value: 5, max: 120, color: ACCENT },\\n    { label: \\\"硕士\\\", value: 4, max: 120, color: GREEN },\\n    { label: \\\"博士\\\", value: 4, max: 120, color: GREEN },\\n    { label: \