st head = [\\n    { text: \\\"序号\\\", options: { bold: true, color: \\\"FFFFFF\\\", align: \\\"center\\\" } },\\n    { text: \\\"企业名称\\\", options: { bold: true, color: \\\"FFFFFF\\\", align: \\\"left\\\" } },\\n    { text: \\\"企业类型\\\", options: { bold: true, color: \\\"FFFFFF\\\", align: \\\"center\\\" } },\\n    { text: \\\"生产状态\\\", options: { bold: true, color: \\\"FFFFFF\\\", align: \\\"center\\\" } },\\n    { text: \\\"员工数\\\", options: { bold: true, color: \\\"FFFFFF\\\", align: \\\"center\\\" } },\\n    { text: \\\"风险等级\\\", options: { bold: true, color: \\\"FFFFFF\\\", align: \\\"center\\\" } }\\n  ];\\n  const data8 = [\\n    [\\\"1\\\", \\\"汉威智慧安全演示企业\\\", \\\"危化品经营\\\", \\\"正常生产\\\", \\\"31\\\", \\\"低风险\\\"],\\n    [\\\"2\\\", \\\"自动化测试专用企业\\\", \\\"危化品经营\\\", \\\"正常生产\\\", \\\"15\\\", \\\"低风险\\\"],\\n    [\\\"3\\\", \\\"河南粮油置业\\\", \\\"危化品生产\\\", \\\"正常生产\\\", \\\"55\\\", \\\"较大风险\\\"],\\n    [\\\"4\\\", \\\"兴阳化工科技有限公司\\\", \\\"危化品生产\\\", \\\"正常生产\\\", \\\"0\\\", \\\"低风险\\\"],\\n    [\\\"5\\\", \\\"测试数据同步功能\\\", \\\"危化行业\\\", \\\"试生产\\\", \\\"0\\\", \\\"低风险\\\"],\\n    [\\\"6\\\", \\\"润广石化测试公司\\\", \\\"危化品经营\\\", \\\"—\\\", \\\"0\\\", \\\"低风险\\\"],\\n    [\\\"7\\\", \\\"璞烯晶新材料（舟山）有限公司\\\", \\\"危化品生产\\\", \\\"未投产\\\", \\\"0\\\", \\\"低风险\\\"],\\n    [\\\"8\\\", \\\"测试天津石化公司\\\", \\\"非危化行业\\\", \\\"未投产\\\", \\\"0\\\", \\\"低风险\\\"],\\n    [\\\"9\\\", \\\"塞上阳光测试公司\\\", \\\"非危化行业\\\", \\\"未投产\\\", \\\"0\\\", \\\"低风险\\\"],\\n    [\\\"10\\\", \\\"天津弘羊生物工程技术有限公司\\\", \\\"非危化行业\\\", \\\"未投产\\\", \\\"0\\\", \\\"未评估\\\"]\\n  ];\\n  const body = data8.map(function (r) {\\n    return [\\n      { text: r[0], options: { align: \\\"center\\\", color: MUTED, fontSize: 10 } },\\n      { text: r[1], options: { align: \\\"left\\\", color: INK, fontSize: 11, bold: true } },\\n      { text: r[2], options: { align: \\\"center\\\", color: INK, fontSize: 10 } },\\n      { text: r[3], options: { align: \\\"center\\\", color: INK, fontSize: 10 } },\\n      { text: r[4], options: { align: \\\"center\\\", color: INK, fontSize: 10 } },\\n      { text: r[5], options: { align: \\\"center\\\", color: riskColor(r[5]), fontSize: 10, bold: true } }\\n    ];\\n  });\\n  const tbl = [head].concat(body);\\n  const rowsH = [];\\n  for (let i = 0; i < 11; i++) rowsH.push(i === 0 ? 0.42 : 0.42);\\n  s.addTable(tbl, {\\n    x: MX, y: yTop, w: 12.23, colW: [0.85, 4.6, 2.0, 1.7, 1.1, 1.98],\\n    rowH: rowsH, fontFace: FF, valign: \\\"middle\\\", align: \\\"left\\\",\\n    border: { pt: 0.75, color: \\\"E0E7EF\\\" },\\n    fill: { color: CARD }, autoPage: false\\n  });\\n  // header fill\\n  s.addTable([head], {\\n    x: MX, y: yTop, w: 12.23, colW: [0.85, 4.6, 2.0, 1.7, 1.1, 1.98],\\n    rowH: [0.46], fontFace: FF, valign: \\\"middle\\\", align: \\\"left\\\",\\n    border: { pt: 0.75, color: \\\"1F6F8B\\\" }, fill: { color: NAVY }, autoPage: false\\n  });\\n  s.addText(\\\"注：企业列表接口未按页码返回第 2 页（两次请求结果一致），其余 6 家未在返回数据中；「—」表示生产状态字段未填报。\\\", {\\n    x: MX, y: 6.6, w: 12.23, h: 0.45, fontFace: FF, fontSize: 9.5, color: MUTED, margin: 0\\n  });\\n  footer(s, 8, TOTAL);\\n}\\n\\n// ---------- Slide 9 : 数据说明与口径备注 ----------\\n{\\n  const s = pres.addSlide();\\n  bg(s, BG);\\n  header(s, \\\"NOTES · 数据说明\\\", \\\"数据说明与口径备注\\\");\\n  const yTop = 1.55, hL = 5.42;\\n  const lx = MX, lw = 12.23;\\n  card(s, lx, yTop, lw, hL);\\n  cardTitle(s, lx, yTop, lw, \\\"阅读前请知悉以下口径（源自系统原始返回）\\\", ACCENT);\\n  const notes = [\\n    { t: \\\"企业清单分页未生效\\\", d: \\\"入驻企业列表接口按 pageNo=2 请求返回与第 1 页相同的 10 条记录，本次仅展示 10 家，其余 6 家名称未获取到。\\\" },\\n    { t: \\\"三个明细列表接口返回失败\\\", d: \\\"「重大危险源 / 重点监管工艺 / 重点监管危化品」企业列表接口缺少 type 参数返回 500，仅能展示统计数字（均为 4 家）。\\\" },\\n    { t: \\\"从业人数口径不一致\\\", d: \\\"企业发展统计接口为 66 人，入驻企业状态接口为 101 人；学历统计为 137 人，三处口径来源不同、无法互相验证。\\\" },\\n    { t: \\\"生产状态填报不全\\\", d: \\\"16 家入驻企业中仅 6 家状态为「正常生产」，其余企业状态字段多为空，属于系统原始数据情况。\\\" },\\n    { t: \\\"数值口径与单位\\\", d: \\\"面积、产值、税收等均为系统录入原始值，未标注单位；危化品面积 8.9、规划/建成面积 1.78 等字段原样呈现。\\\" }\\n  ];\\n  let yy = yTop + 0.78;\\n  notes.forEach