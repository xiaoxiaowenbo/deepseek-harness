7) 9px 18px);\\n  pointer-events:none;\\n}\\n.statusbar .wrap{display:flex;align-items:center;gap:14px;flex-wrap:wrap}\\n.beacon{\\n  width:9px;height:9px;border-radius:50%;background:var(--red);\\n  box-shadow:0 0 0 0 rgba(255,77,61,.7);\\n  animation:pulse 1.9s infinite;flex:none;\\n}\\n@keyframes pulse{\\n  0%{box-shadow:0 0 0 0 rgba(255,77,61,.6)}\\n  70%{box-shadow:0 0 0 11px rgba(255,77,61,0)}\\n  100%{box-shadow:0 0 0 0 rgba(255,77,61,0)}\\n}\\n.statusbar b{font-size:13px;letter-spacing:.06em;color:#ffd9d2;font-weight:600}\\n.statusbar span{font-size:12.5px;color:#d99b90}\\n\\n/* ============ 报头 ============ */\\nheader{padding:44px 0 30px;border-bottom:1px solid var(--line)}\\n.kicker{\\n  font-family:var(--font-mono);font-size:11px;letter-spacing:.26em;\\n  color:var(--amber);text-transform:uppercase;margin-bottom:16px;\\n  display:flex;align-items:center;gap:10px;\\n}\\n.kicker::before{content:\\\"\\\";width:26px;height:1px;background:var(--amber);flex:none}\\nh1{\\n  font-size:44px;line-height:1.1;font-weight:800;letter-spacing:-.02em;\\n  color:#fff;margin-bottom:6px;\\n}\\nh1 em{font-style:normal;color:var(--txt-faint);font-weight:300}\\n.sub{font-family:var(--font-mono);font-size:12.5px;color:var(--txt-dim);letter-spacing:.05em;margin-top:14px}\\n.sub b{color:var(--txt);font-weight:500}\\n\\n/* ============ 通用区块 ============ */\\nsection{margin-top:52px}\\n.sec-head{\\n  display:flex;align-items:baseline;gap:16px;\\n  padding-bottom:11px;margin-bottom:26px;\\n  border-bottom:1px solid var(--line);\\n}\\n.sec-no{\\n  font-family:var(--font-mono);font-size:12px;font-weight:700;\\n  color:var(--ink);background:var(--amber);\\n  padding:2px 7px;border-radius:2px;letter-spacing:.05em;flex:none;\\n}\\n.sec-head h2{font-size:20px;font-weight:700;letter-spacing:.01em;color:#fff}\\n.sec-head .note{margin-left:auto;font-size:12px;color:var(--txt-faint);font-family:var(--font-mono)}\\n\\n/* ============ 指标卡 ============ */\\n.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:1px;background:var(--line-soft)}\\n.kpi{background:var(--panel);padding:19px 18px 17px;position:relative}\\n.kpi::before{content:\\\"\\\";position:absolute;left:0;top:0;width:2px;height:100%;background:var(--txt-faint)}\\n.kpi.r::before{background:var(--red)}\\n.kpi.o::before{background:var(--orange)}\\n.kpi.a::before{background:var(--amber)}\\n.kpi.g::before{background:var(--green)}\\n.kpi.b::before{background:var(--blue)}\\n.kpi .k{font-size:11.5px;color:var(--txt-dim);letter-spacing:.05em;margin-bottom:9px}\\n.kpi .v{font-family:var(--font-mono);font-size:29px;font-weight:700;line-height:1;color:#fff;letter-spacing:-.02em}\\n.kpi .v small{font-size:12px;font-weight:400;color:var(--txt-dim);margin-left:4px;letter-spacing:0}\\n.kpi .d{font-size:11.5px;color:var(--txt-faint);margin-top:8px;font-family:var(--font-mono)}\\n.kpi.r .v{color:var(--red)}\\n.kpi.o .v{color:var(--orange)}\\n.kpi.a .v{color:var(--amber)}\\n.kpi.g .v{color:var(--green)}\\n.kpi.b .v{color:var(--blue)}\\n\\n/* ============ 表格 ============ */\\ntable{width:100%;border-collapse:collapse;font-size:13px}\\nth{\\n  text-align:left;font-size:11px;letter-spacing:.1em;text-transform:uppercase;\\n  color:var(--txt-faint);font-weight:500;\\n  padding:9px 12px;border-bottom:1px solid var(--line);\\n  font-family:var(--font-mono);white-space:nowrap;\\n}\\ntd{padding:11px 12px;border-bottom:1px solid var(--line-soft);vertical-align:top}\\ntbody tr:hover td{background:rgba(255,176,32,.035)}\\n.num{font-family:var(--font-mono);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}\\ntd.num{color:#fff}\\n.dim{color:var(--txt-dim)}\\n.faint{color:var(--txt-faint)}\\n\\n/* ============ 徽章 ============ */\\n.tag{\\n  display:inline-block;font-family:var(--font-mono);font-size:10.5px;\\n  padding:1.5px 7px;border-radius:2px;letter-spacing:.05em;white-space:nowrap;\\n  border:1px solid transparent;\\n}\\n.tag.r{background:rgba(255,77,61,.14);color:#ff8b80;border-color:rgba(255,77,61,.35)}\\n.tag.o{background:rgba(255,138,61,.13);color:#ffb184;border-color:rgba(255,138,61,.32)}\\n.tag.a{background:rgba(255,176,32,.13);color:#ffd27a;border-color:rgba(255,176,32,.32)}\\n.tag.g{background:rgba(46,230,168,.12);color:#74f0c8;border-color:rgba(46,230,168,.3)}\\n.tag.n{background:rgba(125,143,163,.1);color:var(--txt-dim);border-color:var(--line)}\\n.tag.z{background:rgba(77,163,255,.12);color:#8cc6ff;border-color:rgba(77,163,255,.3)}\\n\\n/* ============ 横向条形图 ============ */\\n.bars{display:flex;flex-direction:column;gap:11px}\\n.bar-row{display:grid;grid-template-columns:190px 1fr 74px;gap:14px;align-items:center}\\n.bar-row .lbl{font-size:12.5px;color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\\n.bar-track{height:10px;background:var(--panel-2);border-radius:1px;overflow:hidden;position:relative}\\n.bar-fill{height:100%;border-radius:1px;animation:grow .9s cubic-bezier(.2,.8,.2,1) both}\\n@keyframes grow{from{width:0 !important}}\\n.bar-row .val{font-family:var(--font-mono);font-size:12.5px;text-align:right;color:#fff;font-variant-numeric:tabular-nums}\\n\\n/* 堆叠条 */\\n.stack{display:flex;height:12px;border-radius:1px;overflow:hidden;background:var(--panel-2)}\\n.stack i{display:block;height:100%}\\n.legend{display:flex;gap:20px;flex-wrap:wrap;margin-top:14px;font-size:12px;color:var(--txt-dim)}\\n.legend i{display:inline-block;width:9px;height:9px;border-radius:1px;margin-right:7px;vertical-align:middle}\\n.legend b{color:#fff;font-family:var(--font-mono);font-weight:600}\\n\\n/* ============ 环形图 ============ */\\n.donut-wrap{display:grid;grid-template-columns:170px 1fr;gap:34px;align-items:center}\\n.donut{position:relative;width:170px;height:170px}\\n.donut svg{transform:rotate(-90deg);display:block}\\n.donut .mid{\\n  position:absolute;inset:0;display:flex;flex-direction:column;\\n  align-items:center;justify-content:center;text-align:center;\\n}\\n.donut .mid b{font-family:var(--font-mono);font-size:31px;font-weight:700;color:#fff;line-height:1}\\n.donut .mid span{font-size:11px;color:var(--txt-faint);letter-spacing:.1em;margin-top:5px}\\n\\n/* ============ 风险卡 ============ */\\n.risks{display:flex;flex-direction:column;gap:14px}\\n.risk{\\n  background:var(--panel);border:1px solid var(--line);\\n  border-left:2px solid var(--txt-faint);\\n  padding:20px 22px;position:relative;\\n}\\n.risk.sev-1{border-left-color:var(--red)}\\n.risk.sev-2{border-left-color:var(--orange)}\\n.risk.sev-3{border-left-color:var(--amber)}\\n.risk-h{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:11px}\\n.risk-h h3{font-size:15.5px;font-weight:700;color:#fff;letter-spacing:.01em}\\n.risk-h .tag{margin-left:auto}\\n.risk p{font-size:13px;color:var(--txt-dim);margin-bottom:12px}\\n.risk p b{color:var(--txt);font-weight:600}\\n.mini{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:1px;background:var(--line-soft);margin-top:13px}\\n.mini div{background:var(--panel-2);padding:11px 13px}\\n.mini .mk{font-size:11px;color:var(--txt-faint);margin-bottom:5px;letter-spacing:.04em}\\n.mini .mv{font-family:var(--font-mono);font-size:17px;font-weight:700;color:#fff;line-height:1;font-variant-numeric:tabular-nums}\\n.mini .mv.r{color:var(--red)}.mini .mv.o{color:var(--orange)}.mini .mv.a{color:var(--amber)}.mini .mv.g{color:var(--green)}\\n\\n/* ============ 调用框 ============ */\\n.callout{\\n  background:linear-gradient(180deg,rgba(255,176,32,.07),rgba(255,176,32,.02));\\n  border:1px solid rgba(255,176,32,.28);\\n  padding:17px 20px;font-size:13px;color:var(--txt-dim);\\n}\\n.callout b{color:var(--amber);font-weight:600}\\n.callout.danger{\\n  background:linear-gradient(180deg,rgba(255,77,61,.08),rgba(255,77,61,.02));\\n  border-color:rgba(255,77,61,.3);\\n}\\n.callout.danger b{color:var(--red)}\\n\\n/* ============ 督办清单 ============ */\\n.actions{display:flex;flex-direction:column;gap:1px;background:var(--line-soft)}\\n.action{background:var(--panel);padding:15px 20px;display:grid;grid-template-columns:64px 1fr auto;gap:18px;align-items:center}\\n.action .pri{\\n  font-family:var(--font-mono);font-size:11px;font-weight:700;\\n  text-align:center;padding:4px 0;border-radius:2px;letter-spacing:.06em;\\n}\\n.action .pri.p0{background:var(--red);color:#1a0806}\\n.action .pri.p1{background:var(--orange);color:#1a0d05}\\n.action .pri.p2{background:var(--amber);color:#1a1204}\\n.action .txt{font-size:13.5px;color:var(--txt)}\\n.action .txt em{font-style:normal;color:var(--txt-faint);display:block;font-size:12px;margin-top:3px}\\n.action .own{font-size:12px;color:var(--txt-dim);font-family:var(--font-mono);text-align:right;white-space:nowrap}\\n\\n/* ============ 附录 ============ */\\ndetails{border:1px solid var(--line);background:var(--panel);padding:0}\\ndetails summary{\\n  cursor:pointer;padding:14px 20px;font-size:13.5px;font-weight:600;color:var(--txt);\\n  list-style:none;display:flex;align-items:center;gap:10px;\\n}\\ndetails summary::-webkit-details-marker{display:none}\\ndetails summary::before{\\n  content:\\\"+\\\";font-family:var(--font-mono);color:var(--amber);font-size:15px;\\n  width:14px;display:inline-block;\\n}\\ndetails[open] summary::before{content:\\\"−\\\"}\\ndetails .body{padding:4px 20px 20px;border-top:1px solid var(--line-soft)}\\n\\nfooter{\\n  margin-top:64px;padding-top:26px;border-top:1px solid var(--line);\\n  font-size:11.5px;color:var(--txt-faint);font-family:var(--font-mono);\\n  display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;\\n}\\n\\n/* ============ 入场动画 ============ */\\n.rise{animation:rise .6s cubic-bezier(.2,.8,.2,1) both}\\n@keyframes rise{from{opacity:0;transform:translateY(11px)}}\\n.d1{animation-delay:.05s}.d2{animation-delay:.12s}.d3{animation-delay:.19s}\\n.d4{animation-delay:.26s}.d5{animation-delay:.33s}.d6{animation-delay:.4s}\\n\\n/* ============ 打印 A4 ============ */\\n@media print{\\n  @page{size:A4;margin:14mm 12mm}\\n  body{\\n    background:#fff;color:#111;font-size:10.5pt;padding:0;\\n    background-image:none;\\n  }\\n  .statusbar{background:#fff;border-bottom:2px solid #c0392b;padding:8px 0}\\n  .statusbar b{color:#a5281a}\\n  .statusbar span{color:#7b3a31}\\n  .statusbar::after{display:none}\\n  .beacon{background:#c0392b;animation:none;box-shadow:none}\\n  .wrap{padding:0;max-width:none}\\n  header{padding:16px 0 12px}\\n  h1{font-size:23pt;color:#000}\\n  h1 em{color:#888}\\n  .kicker{color:#a5281a}\\n  .kicker::before{background:#a5281a}\\n  .sub{color:#555}\\n  section{margin-top:20px;page-break-inside:avoid}\\n  .sec-no{background:#222;color:#fff}\\n  .sec-head{border-bottom:1px solid #bbb}\\n  .sec-head h2{color:#000}\\n  .sec-head .note{color:#777}\\n  .kpi,.risk,.action,details{background:#fff;border-color:#ccc}\\n  .kpi::before{background:#999}\\n  .mini div{background:#f6f6f6}\\n  .mini .mv,.kpi .v,.bar-row .val,.donut .mid b{color:#000}\\n  .kpi.r .v,.mini .mv.r{color:#c0392b}\\n  .kpi.o .v,.mini .mv.o{color:#c0651a}\\n  .kpi.a .v,.mini .mv.a{color:#9a7000}\\n  .kpi.g .v,.mini .mv.g{color:#0d7a54}\\n  .kpi.b .v{color:#1a5fa8}\\n  .txt,.risk p,.action .txt{color:#222 !important}\\n  .dim,td{color:#333 !important}\\n  .faint{color:#777 !important}\\n  table,.bars,.donut-wrap,.kpis{page-break-inside:avoid}\\n  th{border-bottom:1px solid #999;color:#555}\\n  td{border-bottom:1px solid #e2e2e2}\\n  tbody tr:hover td{background:none}\\n  .bar-track,.stack{background:#e8e8e8}\\n  .bar-fill,.stack i{animation:none !important}\\n  .tag{border-color:#bbb !important;color:#333 !important;background:#f0f0f0 !important}\\n  .callout{background:#fdf6e3;border-color:#d9b24a}\\n  .callout b{color:#8a6100}\\n  .callout.danger{background:#fdecea;border-color:#d98b82}\\n  .callout.danger b{color:#a5281a}\\n  .action .pri.p0{background:#c0392b;color:#fff}\\n  .action .pri.p1{background:#c0651a;color:#fff}\\n  .action .pri.p2{background:#9a7000;color:#fff}\\n  .rise{animation:none}\\n  footer{color:#777}\\n  a{color:#000;text-decoration:none}\\n}\\n@media (max-width:720px){\\n  .wrap{padding:0 16px}\\n  h1{font-size:30px}\\n  .bar-row{grid-template-columns:110px 1fr 54px;gap:9px}\\n  .donut-wrap{grid-template-columns:1fr;justify-items:center;gap:20px}\\n  .action{grid-template-columns:52px 1fr;gap:12px}\\n  .action .own{grid-column:2;text-align:left}\\n}\\n</style>\\n</head>\\n<body>\\n\\n<!-- ================= 状态条 ================= -->\\n<div class=\\\"statusbar\\\">\\n  <div class=\\\"wrap\\\">\\n    <i class=\\\"beacon\\\"></i>\\n    <b>一级告警未闭环</b>\\n    <span>河南粮油置业 · 可燃气体（甲烷）监测报警 50 条 · 处理率 0% · 消警率 0%</span>\\n  </div>\\n</div>\\n\\n<div class=\\\"wrap\\\">\\n\\n<!-- ================= 报头 ================= -->\\n<header class=\\\"rise\\\">\\n  <div class=\\\"kicker\\\">Chemical Industry Park / Daily Safety Report</div>\\n  <h1>化工园区1 <em>·</em> 安全日报</h1>\\n  <div class=\\\"sub\\\">\\n    报告日期 <b>2026-09-10</b> ｜ 统计口径 <b>自然日 00:00–24:00</b> ｜ 覆盖企业 <b>16 家</b><br>\\n    数据来源 <b>预发布园区数据库（preprod_park）</b> ｜ 生成方式 <b>数据库直采</b> ｜ 报告编号 <b>PARK-1-DSR-20260910</b>\\n  </div>\\n</header>\\n\\n<div style=\\\"margin-top:24px\\\" class=\\\"rise d1\\\">\\n  <div class=\\\"callout danger\\\">\\n    <b>本报告为人工补录版本。</b>系统内置日报模块 <code style=\\\"font-family:var(--font-mono);color:var(--txt-dim)\\\">park_report</code>（type 1=日报 / 2=周报 / 3=月报）当前记录数为 <b>0</b>，从未生成过任何日报；\\n    同时园区大屏接口（park-cloud）返回 <b>HTTP 401 未登录</b>，在线监测、双重预防等模块实时数据暂不可取。\\n    本报告全部指标取自数据库直采，反映的是各业务模块<b>最后留存的真实数据</b>，而非当日实时值。\\n  </div>\\n</div>\\n\\n<!-- ================= 一、数据时效 ================= -->\\n<section class=\\\"rise d2\\\">\\n  <div class=\\\"sec-head\\\">\\n    <span class=\\\"sec-no\\\">01</span>\\n    <h2>数据时效性核查</h2>\\n    <span class=\\\"note\\\">以本日 00:00 为基准</span>\\n  </div>\\n\\n  <p style=\\\"font-size:13px;color:var(--txt-dim);margin-bottom:20px\\\">\\n    当日 00:00 至今，全部业务模块新增记录数均为 <b style=\\\"color:var(--txt)\\\">0</b>。以下为各模块最后一次写入时间，\\n    <b style=\\\"color:var(--red)\\\">最早断更已达 78 天</b>，说明数据采集链路整体处于停滞状态。\\n  </p>\\n\\n  <div class=\\\"bars\\\">\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">特殊作业</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:20.5%;background:var(--orange)\\\"></span></span><span class=\\\"val\\\">16 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">风险承诺公告</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:28.2%;background:var(--orange)\\\"></span></span><span class=\\\"val\\\">22 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">人员入园申请</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:29.5%;background:var(--orange)\\\"></span></span><span class=\\\"val\\\">23 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">离线报备</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:44.9%;background:var(--amber)\\\"></span></span><span class=\\\"val\\\">35 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">人员定位</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:47.4%;background:var(--amber)\\\"></span></span><span class=\\\"val\\\">37 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">隐患排查记录</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:56.4%;background:var(--red)\\\"></span></span><span class=\\\"val\\\">44 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">隐患整改记录</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:56.4%;background:var(--red)\\\"></span></span><span class=\\\"val\\\">44 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">装置大检修备案</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:98.7%;background:var(--red)\\\"></span></span><span class=\\\"val\\\">77 天</span></div>\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">装置开车备案</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:100%;background:var(--red)\\\"></span></span><span class=\\\"val\\\">78 天</span></div>\\n  </div>\\n\\n  <table style=\\\"margin-top:26px\\\">\\n    <thead>\\n      <tr><th>业务模块</th><th>最后数据时间</th><th class=\\\"num\\\">断更天数</th><th class=\\\"num\\\">累计记录</th><th>状态</th></tr>\\n    </thead>\\n    <tbody>\\n      <tr><td>特殊作业报备</td><td class=\\\"dim\\\">2026-08-25 15:39</td><td class=\\\"num\\\">16</td><td class=\\\"num\\\">328</td><td><span class=\\\"tag o\\\">滞后</span></td></tr>\\n      <tr><td>风险承诺公告</td><td class=\\\"dim\\\">2026-08-19 14:50</td><td class=\\\"num\\\">22</td><td class=\\\"num\\\">16</td><td><span class=\\\"tag o\\\">滞后</span></td></tr>\\n      <tr><td>人员入园申请</td><td class=\\\"dim\\\">2026-08-18 18:06</td><td class=\\\"num\\\">23</td><td class=\\\"num\\\">11</td><td><span class=\\\"tag o\\\">滞后</span></td></tr>\\n      <tr><td>离线报备</td><td class=\\\"dim\\\">2026-08-06 16:47</td><td class=\\\"num\\\">35</td><td class=\\\"num\\\">14</td><td><span class=\\\"tag a\\\">停滞</span></td></tr>\\n      <tr><td>人员实时定位</td><td class=\\\"dim\\\">2026-08-04 09:56</td><td class=\\\"num\\\">37</td><td class=\\\"num\\\">3</td><td><span class=\\\"tag r\\\">失效</span></td></tr>\\n      <tr><td>隐患排查记录</td><td class=\\\"dim\\\">2026-07-28 11:01</td><td class=\\\"num\\\">44</td><td class=\\\"num\\\">194</td><td><span class=\\\"tag r\\\">停滞</span></td></tr>\\n      <tr><td>隐患整改记录</td><td class=\\\"dim\\\">2026-07-28 11:01</td><td class=\\\"num\\\">44</td><td class=\\\"num\\\">249</td><td><span class=\\\"tag r\\\">停滞</span></td></tr>\\n      <tr><td>装置大检修备案</td><td class=\\\"dim\\\">2026-06-25 17:27</td><td class=\\\"num\\\">77</td><td class=\\\"num\\\">20</td><td><span class=\\\"tag r\\\">停滞</span></td></tr>\\n      <tr><td>装置开车备案</td><td class=\\\"dim\\\">2026-06-24 17:47</td><td class=\\\"num\\\">78</td><td class=\\\"num\\\">17</td><td><span class=\\\"tag r\\\">停滞</span></td></tr>\\n      <tr><td>装置停车备案</td><td class=\\\"faint\\\">无任何数据</td><td class=\\\"num faint\\\">—</td><td class=\\\"num\\\">0</td><td><span class=\\\"tag n\\\">未启用</span></td></tr>\\n      <tr><td>人员定位报警</td><td class=\\\"faint\\\">无任何数据</td><td class=\\\"num faint\\\">—</td><td class=\\\"num\\\">0</td><td><span class=\\\"tag n\\\">未启用</span></td></tr>\\n    </tbody>\\n  </table>\\n</section>\\n\\n<!-- ================= 二、当日态势 ================= -->\\n<section class=\\\"rise d3\\\">\\n  <div class=\\\"sec-head\\\">\\n    <span class=\\\"sec-no\\\">02</span>\\n    <h2>当日安全态势</h2>\\n    <span class=\\\"note\\\">2026-09-10</span>\\n  </div>\\n\\n  <div class=\\\"kpis\\\">\\n    <div class=\\\"kpi r\\\">\\n      <div class=\\\"k\\\">企业风险承诺公告</div>\\n      <div class=\\\"v\\\">0<small>条</small></div>\\n      <div class=\\\"d\\\">应报 4 家 · 落实率 0%</div>\\n    </div>\\n    <div class=\\\"kpi r\\\">\\n      <div class=\\\"k\\\">隐患排查新增</div>\\n      <div class=\\\"v\\\">0<small>条</small></div>\\n      <div class=\\\"d\\\">排查链路停摆</div>\\n    </div>\\n    <div class=\\\"kpi r\\\">\\n      <div class=\\\"k\\\">人员在岗定位</div>\\n      <div class=\\\"v\\\">0<small>条</small></div>\\n      <div class=\\\"d\\\">37 天无上报</div>\\n    </div>\\n    <div class=\\\"kpi g\\\">\\n      <div class=\\\"k\\\">特殊作业</div>\\n      <div class=\\\"v\\\">0<small>项</small></div>\\n      <div class=\\\"d\\\">8 类作业全为 0</div>\\n    </div>\\n    <div class=\\\"kpi g\\\">\\n      <div class=\\\"k\\\">重大危险源点位报警</div>\\n      <div class=\\\"v\\\">0<small>条</small></div>\\n      <div class=\\\"d\\\">点位在线率 0%</div>\\n    </div>\\n    <div class=\\\"kpi g\\\">\\n      <div class=\\\"k\\\">装置开停车 / 检修</div>\\n      <div class=\\\"v\\\">0<small>项</small></div>\\n      <div class=\\\"d\\\">无备案</div>\\n    </div>\\n  </div>\\n\\n  <div style=\\\"margin-top:20px\\\">\\n    <div class=\\\"callout\\\">\\n      <b>当日\\\"零报警\\\"不等于\\\"零风险\\\"。</b>由于物联网点位在线率为 0%、企业接入率仅 29%，当日报警数为 0 属于\\n      <b>数据缺失导致的假阴性</b>，不能作为安全状态良好的依据。\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- ================= 三、核心风险 ================= -->\\n<section class=\\\"rise d4\\\">\\n  <div class=\\\"sec-head\\\">\\n    <span class=\\\"sec-no\\\">03</span>\\n    <h2>核心风险清单</h2>\\n    <span class=\\\"note\\\">按严重程度排序 · 共 6 项</span>\\n  </div>\\n\\n  <div class=\\\"risks\\\">\\n\\n    <!-- 风险 1 -->\\n    <div class=\\\"risk sev-1\\\">\\n      <div class=\\\"risk-h\\\">\\n        <h3>重大危险源监测报警 50 条，全部未闭环</h3>\\n        <span class=\\\"tag r\\\">P0 紧急</span>\\n      </div>\\n      <p>\\n        企业 <b>河南粮油置业</b> 的 5 个可燃气体探测器（甲烷）在 2 天内反复触发低报报警，\\n        监测值 55.0–65.0。<b>消警 0 条、处理 0 条</b>，报警链路完全未闭环。\\n        该企业同时是园区<b>唯一\\\"较大风险\\\"等级企业</b>，并持有 2 个一级重大危险源。\\n      </p>\\n      <div class=\\\"mini\\\">\\n        <div><div class=\\\"mk\\\">报警总数</div><div class=\\\"mv r\\\">50</div></div>\\n        <div><div class=\\\"mk\\\">未消警</div><div class=\\\"mv r\\\">50</div></div>\\n        <div><div class=\\\"mk\\\">未处理</div><div class=\\\"mv r\\\">50</div></div>\\n        <div><div class=\\\"mk\\\">持续时长</div><div class=\\\"mv\\\">2 天</div></div>\\n        <div><div class=\\\"mk\\\">触发点位</div><div class=\\\"mv\\\">5</div></div>\\n      </div>\\n      <p style=\\\"margin:13px 0 0;font-size:12px\\\" class=\\\"faint\\\">\\n        触发点位：ZDHCSQYSB.的探测器_1_2 / _3 / _7 / _8 / _9 ｜ 时间窗：2026-08-24 ~ 2026-08-25 ｜ 介质：甲烷（可燃气体）\\n      </p>\\n    </div>\\n\\n    <!-- 风险 2 -->\\n    <div class=\\\"risk sev-1\\\">\\n      <div class=\\\"risk-h\\\">\\n        <h3>隐患逾期未整改 77 条，含重大隐患 27 条</h3>\\n        <span class=\\\"tag r\\\">P0 紧急</span>\\n      </div>\\n      <p>\\n        园区累计隐患 153 条（一般 112 / 重大 41），已整改 59 条，<b>整改率仅 38.56%</b>。\\n        待整改 94 条中 <b>77 条已超期</b>，占待整改总量的 82%；最长逾期达 <b>519 天</b>。\\n        另有 3 家企业整改完成数为 0。\\n      </p>\\n\\n      <div class=\\\"donut-wrap\\\" style=\\\"margin-top:18px\\\">\\n        <div class=\\\"donut\\\">\\n          <svg width=\\\"170\\\" height=\\\"170\\\" viewBox=\\\"0 0 170 170\\\">\\n            <circle cx=\\\"85\\\" cy=\\\"85\\\" r=\\\"66\\\" fill=\\\"none\\\" stroke=\\\"#18222e\\\" stroke-width=\\\"17\\\"></circle>\\n            <circle cx=\\\"85\\\" cy=\\\"85\\\" r=\\\"66\\\" fill=\\\"none\\\" stroke=\\\"#2ee6a8\\\" stroke-width=\\\"17\\\"\\n                    stroke-dasharray=\\\"159.9 414.7\\\" stroke-dashoffset=\\\"0\\\"></circle>\\n            <circle cx=\\\"85\\\" cy=\\\"85\\\" r=\\\"66\\\" fill=\\\"none\\\" stroke=\\\"#ff4d3d\\\" stroke-width=\\\"17\\\"\\n                    stroke-dasharray=\\\"227.6 414.7\\\" stroke-dashoffset=\\\"-159.9\\\"></circle>\\n            <circle cx=\\\"85\\\" cy=\\\"85\\\" r=\\\"66\\\" fill=\\\"none\\\" stroke=\\\"#ffb020\\\" stroke-width=\\\"17\\\"\\n                    stroke-dasharray=\\\"27.1 414.7\\\" stroke-dashoffset=\\\"-387.5\\\"></circle>\\n          </svg>\\n          <div class=\\\"mid\\\"><b>153</b><span>隐患总数</span></div>\\n        </div>\\n        <div>\\n          <div class=\\\"legend\\\" style=\\\"margin-top:0;flex-direction:column;gap:13px\\\">\\n            <span><i style=\\\"background:#2ee6a8\\\"></i>已整改 <b>59</b> <span class=\\\"faint\\\">38.56%</span></span>\\n            <span><i style=\\\"background:#ff4d3d\\\"></i>未整改 <b>84</b> <span class=\\\"faint\\\">54.90%</span></span>\\n            <span><i style=\\\"background:#ffb020\\\"></i>整改中 <b>10</b> <span class=\\\"faint\\\">6.54%</span></span>\\n          </div>\\n          <div class=\\\"mini\\\" style=\\\"margin-top:18px\\\">\\n            <div><div class=\\\"mk\\\">逾期未整改</div><div class=\\\"mv r\\\">77</div></div>\\n            <div><div class=\\\"mk\\\">其中重大隐患</div><div class=\\\"mv r\\\">27</div></div>\\n            <div><div class=\\\"mk\\\">最长逾期</div><div class=\\\"mv r\\\">519 天</div></div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <!-- 风险 3 -->\\n    <div class=\\\"risk sev-2\\\">\\n      <div class=\\\"risk-h\\\">\\n        <h3>风险预警 33 条，82% 未处置</h3>\\n        <span class=\\\"tag o\\\">P1 高</span>\\n      </div>\\n      <p>\\n        本园区 16 家租户累计预警 <b>33 条</b>，其中红色 9 条、橙色 24 条。\\n        <b>未处置 27 条</b>、正在持续 23 条、已消警仅 8 条。最新一条为 2026-08-13 河南粮油置业橙色预警，至今无处置动作。\\n      </p>\\n      <div class=\\\"mini\\\">\\n        <div><div class=\\\"mk\\\">红色预警</div><div class=\\\"mv r\\\">9</div></div>\\n        <div><div class=\\\"mk\\\">橙色预警</div><div class=\\\"mv o\\\">24</div></div>\\n        <div><div class=\\\"mk\\\">未处置</div><div class=\\\"mv r\\\">27</div></div>\\n        <div><div class=\\\"mk\\\">正在持续</div><div class=\\\"mv o\\\">23</div></div>\\n        <div><div class=\\\"mk\\\">已消警</div><div class=\\\"mv g\\\">8</div></div>\\n      </div>\\n      <p style=\\\"margin:13px 0 0;font-size:12px\\\" class=\\\"faint\\\">\\n        红色预警对象：硫酸罐 · 苯制品反应容器 · 氯化制品反应容器 · 液化天然气存储设施 · 燃气储罐 · 罐区1 · 可燃气体 · 易燃化学品\\n      </p>\\n    </div>\\n\\n    <!-- 风险 4 -->\\n    <div class=\\\"risk sev-2\\\">\\n      <div class=\\\"risk-h\\\">\\n        <h3>13 个重大危险源中 7 个备案已过期</h3>\\n        <span class=\\\"tag o\\\">P1 高</span>\\n      </div>\\n      <p>\\n        园区共备案重大危险源 <b>13 个</b>，分布于 6 家企业。其中 <b>7 个备案有效期已届满</b>，\\n        四级危险源过期比例最高（4 个中 3 个过期）。\\n      </p>\\n      <div class=\\\"mini\\\">\\n        <div><div class=\\\"mk\\\">一级危险源</div><div class=\\\"mv r\\\">7 <span style=\\\"font-size:11px;color:var(--txt-faint)\\\">过期 2</span></div></div>\\n        <div><div class=\\\"mk\\\">二级危险源</div><div class=\\\"mv o\\\">2 <span style=\\\"font-size:11px;color:var(--txt-faint)\\\">过期 2</span></div></div>\\n        <div><div class=\\\"mk\\\">三级危险源</div><div class=\\\"mv\\\">0</div></div>\\n        <div><div class=\\\"mk\\\">四级危险源</div><div class=\\\"mv a\\\">4 <span style=\\\"font-size:11px;color:var(--txt-faint)\\\">过期 3</span></div></div>\\n        <div><div class=\\\"mk\\\">涉及企业</div><div class=\\\"mv\\\">6</div></div>\\n      </div>\\n    </div>\\n\\n    <!-- 风险 5 -->\\n    <div class=\\\"risk sev-3\\\">\\n      <div class=\\\"risk-h\\\">\\n        <h3>特殊作业抽查异常率偏高</h3>\\n        <span class=\\\"tag a\\\">P2 中</span>\\n      </div>\\n      <p>\\n        累计报备特殊作业 328 项，在线抽查 39 次，异常结果集中出现。2026-08 为作业高峰（单日最高 13 项）。\\n        作业类型高度集中于动火与受限空间两类，均为高风险作业。\\n      </p>\\n      <div class=\\\"mini\\\">\\n        <div><div class=\\\"mk\\\">累计报备</div><div class=\\\"mv\\\">328 项</div></div>\\n        <div><div class=\\\"mk\\\">第三方作业</div><div class=\\\"mv\\\">19 项</div></div>\\n        <div><div class=\\\"mk\\\">第三方单位</div><div class=\\\"mv\\\">7 家</div></div>\\n        <div><div class=\\\"mk\\\">在线抽查</div><div class=\\\"mv\\\">39 次</div></div>\\n        <div><div class=\\\"mk\\\">8月作业量</div><div class=\\\"mv a\\\">82 项</div></div>\\n      </div>\\n      <p style=\\\"margin:13px 0 0;font-size:12px\\\" class=\\\"faint\\\">\\n        抽查异常集中企业：汉威智慧安全演示企业（受限空间、一级/二级动火、临时用电）· 河南粮油置业（受限空间、一级动火）\\n      </p>\\n    </div>\\n\\n    <!-- 风险 6 -->\\n    <div class=\\\"risk sev-3\\\">\\n      <div class=\\\"risk-h\\\">\\n        <h3>风险承诺公告未落实</h3>\\n        <span class=\\\"tag a\\\">P2 中</span>\\n      </div>\\n      <p>\\n        承诺公告名单 6 条中仅 2 条已承诺，<b>3 条未承诺、1 条逾期承诺</b>；\\n        明细台账 16 条，最近一次实际承诺停留在 2026-08-19，已 22 天未更新。\\n      </p>\\n      <div class=\\\"mini\\\">\\n        <div><div class=\\\"mk\\\">已承诺</div><div class=\\\"mv g\\\">2</div></div>\\n        <div><div class=\\\"mk\\\">未承诺</div><div class=\\\"mv r\\\">3</div></div>\\n        <div><div class=\\\"mk\\\">逾期承诺</div><div class=\\\"mv o\\\">1</div></div>\\n        <div><div class=\\\"mk\\\">台账明细</div><div class=\\\"mv\\\">16</div></div>\\n      </div>\\n    </div>\\n\\n  </div>\\n</section>\\n\\n<!-- ================= 四、企业隐患排行 ================= -->\\n<section class=\\\"rise d5\\\">\\n  <div class=\\\"sec-head\\\">\\n    <span class=\\\"sec-no\\\">04</span>\\n    <h2>企业隐患分布</h2>\\n    <span class=\\\"note\\\">按隐患总数降序</span>\\n  </div>\\n\\n  <div class=\\\"bars\\\" style=\\\"margin-bottom:26px\\\">\\n    <div class=\\\"bar-row\\\"><span class=\\\"lbl\\\">自动化测试专用企业</span><span class=\\\"bar-track\\\"><span class=\\\"bar-fill\\\" style=\\\"width:100%;